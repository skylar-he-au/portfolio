# Local development only: these values point at the compose database. Never put real credentials here.
# Copy to .env. Inside compose the containers use db:5432 instead (see docker-compose.yml).
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio
APP_ENV=dev
API_ORIGIN=http://localhost:8000
# Development-account keys for Ask (step 3). Never put production keys here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Worker authentication and Cloudflare Turnstile.
ORIGIN_SECRET=
SESSION_SECRET=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
SPEND_DAILY_USD_ANTHROPIC=
SPEND_DAILY_USD_GOOGLE=
SPEND_DAILY_USD_OPENAI=
SPEND_MONTHLY_USD_ANTHROPIC=
SPEND_MONTHLY_USD_GOOGLE=
SPEND_MONTHLY_USD_OPENAI=
