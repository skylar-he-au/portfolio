# Local development only: these values point at the compose database. Never put real credentials here.
# Copy to .env. Inside compose the containers use db:5432 instead (see docker-compose.yml).
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio
APP_ENV=dev
API_ORIGIN=http://localhost:8000
# Development-account keys for Ask (step 3). Never put production keys here.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Embeddings: an Azure OpenAI deployment of text-embedding-3-small (the dev resource).
# ENDPOINT is https://<resource>.openai.azure.com/; DEPLOYMENT is the deployment name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# The deployment's tokens-per-minute limit; ingest sends at most half of it per minute.
# AZURE_OPENAI_TPM=5000
# Evals only: RAGAS embeddings and the old OpenAI model comparisons.
OPENAI_API_KEY=

# Worker authentication and Cloudflare Turnstile.
ORIGIN_SECRET=
SESSION_SECRET=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
# Only used in the local compose setup and by the patrol job.
PATROL_SECRET=
# Cloud Scheduler OIDC audience and service account email for cleanup.
CLEANUP_AUDIENCE=
CLEANUP_INVOKER_EMAIL=
SPEND_DAILY_USD_ANTHROPIC=
SPEND_DAILY_USD_GOOGLE=
SPEND_DAILY_USD_OPENAI=
SPEND_MONTHLY_USD_ANTHROPIC=
SPEND_MONTHLY_USD_GOOGLE=
SPEND_MONTHLY_USD_OPENAI=
# ASK_LIMIT_TOKEN=20
# ASK_LIMIT_IP=20
# ASK_LIMIT_SITE=300
# MATCH_LIMIT_TOKEN=3
# MATCH_LIMIT_IP=3
# MATCH_LIMIT_SITE=30
# SPEND_INPUT_TOKENS_ESTIMATE=12000
