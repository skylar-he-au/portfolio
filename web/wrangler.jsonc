{
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ORIGIN_URL": "http://localhost:8000"
  }
}
