---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Assistant from '../../components/Assistant';
import Toc from '../../components/Toc.astro';
import Base from '../../layouts/Base.astro';
import { addSectionAnchors } from '../../lib/anchors';
import { parseExamples } from '../../lib/examples';
import { readingMinutes } from '../../lib/reading-time';
import '../../styles/assistant.css';
import '../../styles/blog.css';
// project-page.css comes with the highlight script in Base.astro, on every page.

export async function getStaticPaths() {
  const articles = await getCollection('pages', ({ id, data }) => id.startsWith('blog/') && !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id.slice('blog/'.length) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
if (!entry.rendered) throw new Error(`Missing rendered content: ${entry.id}`);
if (!entry.data.date) throw new Error(`Missing front matter: ${entry.id} date`);
const date = entry.data.date;
const dateFormat = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric',
});
// The contents list: the same h2 headings and Astro ids the body renders.
const headings = (await render(entry)).headings
  .filter((heading) => heading.depth === 2)
  .map(({ slug: id, text }) => ({ slug: id, text }));

const examplesEntry = await getEntry('pages', 'examples');
if (!examplesEntry?.body) throw new Error('Missing content: examples');
const examples = parseExamples(examplesEntry.body);
const about = await getEntry('pages', 'about');
const contactHref = about && (await render(about)).headings.some((heading) => heading.slug === 'contact')
  ? '/about#contact' : '/about';

// Published source titles, so answers and the job match can name each section's page.
const pageTitles = Object.fromEntries(
  (await getCollection('pages', ({ id, data }) =>
    id.startsWith('projects/') || (id.startsWith('blog/') && !data.draft)))
    .map((page) => [`/${page.id}`, page.data.title]),
);
---

<Base title={entry.data.title} description={entry.data.summary} layout="wide" glow>
  <div class="project-page">
    <div class="project-head">
      <h1>{entry.data.title}</h1>
      <p class="blog-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{dateFormat.format(date)}</time>
        {' · '}{readingMinutes(entry.body ?? '')} min read
      </p>
    </div>
    <Toc headings={headings} />
    <div class="markdown project-body">
      <Fragment set:html={addSectionAnchors(entry.rendered.html)} />
      <p>Questions? Ask my projects above or <a href={contactHref}>email me</a></p>
    </div>
    {/* One assistant for the whole page: the right column from 960px, a bottom bar and a
        dialog below that (project-page.css). Two copies would be two conversations. */}
    <div class="project-ask">
      <button type="button" class="ask-bar" aria-haspopup="dialog" aria-controls="ask-dialog" aria-expanded="false">
        <span class="ask-bar-dot" aria-hidden="true"></span>
        <span class="ask-bar-text">Ask about my projects</span>
        <span class="ask-bar-go" aria-hidden="true">Ask</span>
      </button>
      <dialog id="ask-dialog" class="ask-dialog" aria-labelledby="ask-dialog-title">
        <div class="ask-dialog-head">
          <h2 id="ask-dialog-title" class="ask-dialog-title">Ask about my projects</h2>
          <form method="dialog" class="ask-dialog-close">
            <button type="submit">Close</button>
          </form>
        </div>
        <Assistant client:visible variant="panel" examples={examples} pageTitles={pageTitles} />
      </dialog>
    </div>
  </div>
</Base>

<script>
  // Below 960px the panel is a bottom bar that opens the dialog as a sheet; from 960px the
  // dialog is the right column (CSS shows it while closed), so an open sheet closes on widening.
  const dialog = document.querySelector<HTMLDialogElement>('#ask-dialog');
  const bar = document.querySelector<HTMLButtonElement>('.ask-bar');
  const wide = window.matchMedia('(min-width: 960px)');

  if (dialog && bar) {
    bar.addEventListener('click', () => {
      if (!dialog.open) dialog.showModal();
      bar.setAttribute('aria-expanded', 'true');
    });
    dialog.addEventListener('close', () => bar.setAttribute('aria-expanded', 'false'));
    // A click on the backdrop, outside the sheet, closes it as well.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && dialog.matches(':modal')) dialog.close();
    });
    wide.addEventListener('change', () => {
      if (wide.matches && dialog.open) dialog.close();
    });
  }
</script>
