---
import { getEntry } from 'astro:content';
import EmailLinks from '../components/EmailLinks.astro';
import Base from '../layouts/Base.astro';
import { addSectionAnchors } from '../lib/anchors';
import { renderEmailPlaceholder } from '../lib/email';

const entry = await getEntry('pages', 'privacy');
if (!entry?.rendered) throw new Error('Missing rendered content: privacy');
---

<Base title={entry.data.title} description={entry.data.summary}>
  <h1>{entry.data.title}</h1>
  <div class="markdown" set:html={renderEmailPlaceholder(
    addSectionAnchors(entry.rendered.html),
    'the email link on the About page',
  )} />
  <EmailLinks />
</Base>

<style>
  .markdown :global(ul) {
    margin-block: var(--space-5);
    padding-inline-start: var(--space-5);
  }

  .markdown :global(li + li) {
    margin-block-start: var(--space-4);
  }

  .markdown :global(strong) {
    font-weight: var(--font-weight-semibold);
  }
</style>
