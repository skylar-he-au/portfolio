---
import Base from '../layouts/Base.astro';
import {
  buildMatchRows,
  buildRagasRows,
  CHECK_LABELS,
  COMPARE_STEP_LABELS,
  compareOptionLabel,
  formatCompareScore,
  formatMatchCost,
  formatSeconds,
  matchJudgeLabel,
  parseCompare,
  SUBSCRIPTION_GRADER,
  SUBSCRIPTION_GRADER_LABEL,
  formatChecks,
  formatCost,
  formatRunCost,
  formatMetric,
  formatQuoteMatch,
  qaGapsLabel,
  qaScoresCaption,
  MATCH_SCORE_LABELS,
  matchPassLines,
  METRIC_LABELS,
  newestFullQaRun,
  parseEvalFiles,
  pickHeadlineCards,
  type CheckName,
} from '../lib/evals';
import compareStep6R2 from '../../../content/evals/compare/step6-r2.json';

const files = import.meta.glob('../../../content/evals/*.json', { eager: true, import: 'default' });
const { qa, cot, match } = parseEvalFiles(Object.values(files));
const headlineCards = pickHeadlineCards(Object.values(files));
const newestFull = newestFullQaRun(qa);
const compare = parseCompare(compareStep6R2);
const judges = [...new Set(qa.map((run) => run.models.judge)
  .filter((judge): judge is string => !!judge && judge !== SUBSCRIPTION_GRADER))];
// From step 10 the Q&A runs are graded by the subscription grader on two metrics only.
const subscriptionGraded = qa.some((run) => run.grader === SUBSCRIPTION_GRADER || run.models.judge === SUBSCRIPTION_GRADER);
const judgeNames = judges.length ? judges.join(', ') : 'claude-sonnet-5-5';
const checkNames = Object.keys(CHECK_LABELS) as CheckName[];
// Notes that explain one published CoT run's numbers, keyed by run_id.
// Notes that explain one published job-match run's numbers, keyed by run_id.
const matchNotes: Record<string, string> = {
  '20261124T234728-match-v5+check-v2-default':
    'Embeddings moved from OpenAI to Azure OpenAI (same model); prompts and step models are unchanged. Every line passed on the tuning ads, averaged over three passes; one pass alone fell under on section recall and not-covered accuracy. Held-out ads are reported only: section recall 0.72, not-covered accuracy 0.85 (0.91 in the previous run), Faithfulness 0.96.',
  '20261119T104825-match-v5+check-v2-final':
    'Every line passed on the tuning ads, which are the ones the pass lines apply to: section recall 0.83, not-covered accuracy 0.91, Faithfulness 0.97 with no row below 0.7, and all code checks. The held-out ads are reported only: section recall 0.73 (0.52–0.87 across passes) stays under 0.8, not-covered accuracy 0.91, Faithfulness 0.96. Each step now has its own model, chosen in the comparison below: Claude Haiku 5.5 with thinking off reads up to 12 requirements (8 before), matches and writes; Gemini 3.5 Flash-Lite with minimal thinking checks. No backup model was used. Faithfulness here comes from the subscription grader, which scores higher than RAGAS on the same guides, so it is not comparable with the runs below. The three passes ran as three runs and are averaged here.',
  '20261119T030433-match-v4-default':
    'No line passed in full. Guide sentences are statements again (none start with an instruction), and Faithfulness rose to 0.89 on the tuning ads and 0.87 on the held-out ads, still under the 0.9 average (3 tuning rows and 1 held-out row below 0.7). Section recall fell to 0.77 on the tuning ads, under the 0.8 line; not-covered accuracy passed on the tuning ads only. One Chinese guide quoted an English line from a section and failed the language check.',
  '20261119T005423-match-v3-default':
    'Section recall and not-covered accuracy passed on the tuning ads; Faithfulness did not (13 tuning rows below 0.7), and the held-out ads missed all three lines. Most guide sentences in this version are instructions (“Check the …”) rather than statements, and those scored lower; the next version goes back to statements.',
};
const cotNotes: Record<string, string> = {
  '20261118T071804-v8-cot':
    'Medium thinking counts toward the 1024-token output cap and ran past it on 55 of 186 calls, so those verdicts were cut off.',
};
---

<Base title="Evals" description="Public scores and counts measuring how well project answers are supported by the project pages.">
  <h1>Evals</h1>
  {headlineCards.length > 0 && (
    <ul class="headline-cards" aria-label="Headline scores">
      {headlineCards.map((card) => (
        <li>
          <span class="headline-value">{card.value}</span>
          <span class="headline-label">{card.label}</span>
          <small>{card.note}</small>
        </li>
      ))}
    </ul>
  )}
  <div class="intro">
    <p>
      This is how I measure whether “Ask about my projects” answers are supported by the project pages.
      The questions are not published because some come from visitors’ wording; only scores and counts are shared.
      Answers are scored by {judgeNames} using RAGAS metrics.
      {subscriptionGraded && <>{' '}From prompt v10, Faithfulness and Context recall are graded by {SUBSCRIPTION_GRADER_LABEL}, and Response relevancy and Factual correctness are not judged.</>}
    </p>
    <dl class="definitions">
      <div>
        <dt>Faithfulness</dt>
        <dd>Share of the answer’s claims that the retrieved page text supports.</dd>
      </div>
      <div>
        <dt>Response relevancy</dt>
        <dd>How directly the answer addresses the question.</dd>
      </div>
      <div>
        <dt>Context recall</dt>
        <dd>How much of the reference answer the retrieved text actually contained.</dd>
      </div>
      <div>
        <dt>Factual correctness</dt>
        <dd>How closely the answer’s facts match a hand-written reference answer.</dd>
      </div>
      <div>
        <dt>Quoted sentences found</dt>
        <dd>From prompt v10, the answer copies the sentence behind each source; code keeps it only if it finds it word for word in that section, and a source link marks only the kept sentences. This is the share kept; it is recorded, with no pass line.</dd>
      </div>
    </dl>
    <p class="note">
      Code checks are plain rule checks: has a citation, sentence count, language, route, fixed reply, and required/forbidden text.
    </p>
    <p class="note">
      Prompt v8 only changed the code fallback for private answers; general answers are the same as in v7.
      It was checked on the 8 private questions × 3 passes and the full-time question 10 times, not with a full final run.
    </p>
    <p class="note">
      Prompt v9 only changed the output of the general answer check: it now gives its verdict without writing reasoning first, the approach that did best in the checker comparison below.
      It was checked with one pass of the general tuning questions (code checks only) and one call to the backup checker, not with a full final run.
      The next change to the prompts, chunking or content gets a full final run.
    </p>
    {newestFull && (
      <p class="note newest-full">
        The newest full final run (every question, three passes) is prompt {newestFull.prompt_version ?? '–'}, {newestFull.date || '–'}.
      </p>
    )}
  </div>

  {qa.length === 0 && cot.length === 0 && match.length === 0 && <p>No eval runs published yet.</p>}

  {qa.map((run) => (
    <section>
      <h2>{run.date || '–'} · prompt {run.prompt_version ?? '–'}</h2>
      <p class="meta">
        Route: {run.route ?? '–'} · Split: {run.split ?? '–'} · {run.questions ?? '–'} questions × {run.repeats ?? '–'} {run.repeats === 1 ? 'pass' : 'passes'} · {run.samples ?? '–'} samples
        <br />
        Answer model: {run.models.answer ?? '–'} / Check model: {run.models.check ?? '–'}
        {run.models.embed && <> / Embedding model: {run.models.embed}</>}
      </p>
      <div class="table-scroll" tabindex="0" role="region" aria-label={`RAGAS scores for ${run.date}, prompt ${run.prompt_version ?? '–'}`}>
        <table>
          <caption>{qaScoresCaption(run)}</caption>
          <thead>
            <tr>
              <th scope="col">Questions</th>
              {Object.values(METRIC_LABELS).map((label) => <th scope="col">{label}</th>)}
            </tr>
          </thead>
          <tbody>
            {buildRagasRows(run).map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.cells.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {checkNames.some((name) => run.code_checks[name]) && (
        <div class="checks">
          <h3>Code checks</h3>
          <ul>
            {checkNames.filter((name) => run.code_checks[name]).map((name) => (
              <li>{CHECK_LABELS[name]}: {formatChecks(run.code_checks[name])}</li>
            ))}
          </ul>
        </div>
      )}
      {formatQuoteMatch(run) && (
        <p class="note">Quoted sentences found on the page: {formatQuoteMatch(run)}</p>
      )}
      {run.private_repeat && (
        <p class="note">
          Full-time question repeated {run.private_repeat.runs} {run.private_repeat.runs === 1 ? 'time' : 'times'}: {run.private_repeat.fixed} fixed sentence, {run.private_repeat.answered} answered from the page, {run.private_repeat.failed} failed
        </p>
      )}
      <p class="meta">
        Errors: {run.errors ?? '–'}
        {(run.ragas_nulls ?? 0) > 0 && <> · {qaGapsLabel(run)}: {run.ragas_nulls}</>}
        {' · '}Cost: {formatRunCost(run)}
      </p>
    </section>
  ))}

  {match.length > 0 && (
    <section class="match">
      <h2>Job match</h2>
      <p>
        Job match reads a job ad and points a recruiter to the project-page sections for each requirement, or lists it as not covered.
        It is scored against hand-checked answers for each ad: which sections each requirement should point to, or that it is not covered.
        The ads mix real postings, ads with hidden instructions, very long ads and Chinese ads; they and the guides are not published, only scores and counts.
      </p>
      <dl class="definitions">
        <div>
          <dt>Section recall</dt>
          <dd>Share of requirements with expected sections where the guide links at least one of them.</dd>
        </div>
        <div>
          <dt>Not-covered accuracy</dt>
          <dd>Share of requirements correctly placed in, or kept out of, the “not covered” line.</dd>
        </div>
        <div>
          <dt>Faithfulness</dt>
          <dd>Share of the guide’s claims that the linked sections support. Up to the 19 Nov 2026 v4 run this is RAGAS; from round 2 it is graded by {SUBSCRIPTION_GRADER_LABEL}, which breaks the guide into statements the same way. On the same v4 guides that grader gave 0.96 where RAGAS gave 0.89, so round-2 Faithfulness is not directly comparable with the older runs.</dd>
        </div>
        <div>
          <dt>Precision</dt>
          <dd>Share of the guide’s links that are among the expected sections; recorded only.</dd>
        </div>
      </dl>
      <p class="note">Code checks: every link was retrieved and found for its requirement, the output fits the schema, the guide is in the ad’s language, and no system prompt or planted text leaks into any streamed event.</p>
      {match.map((run) => (
        <article class="match-run">
          <h3>{run.date || '–'} · prompt {run.prompt_version ?? '–'}</h3>
          <p class="meta">
            {run.questions ?? '–'} job ads × {run.repeats ?? '–'} {run.repeats === 1 ? 'pass' : 'passes'} · {run.samples ?? '–'} samples
            <br />
            Models: {run.models.answer ?? '–'} (read, match, write) / {run.models.check ?? '–'} (check){run.models.embed && <> / {run.models.embed} (embeddings)</>}
            <br />
            Judge: {matchJudgeLabel(run)}{run.grading_status === 'incomplete' && <> · grading incomplete, so not declared over the line</>}
          </p>
          <p class="note pass-lines">Pass lines: {matchPassLines()}.</p>
          <div class="table-scroll" tabindex="0" role="region" aria-label={`Job match scores for ${run.date}, prompt ${run.prompt_version ?? '–'}`}>
            <table>
              <caption>Mean and, for repeated passes, lowest–highest pass average.</caption>
              <thead>
                <tr>
                  <th scope="col">Ads</th>
                  {Object.values(MATCH_SCORE_LABELS).map((label) => <th scope="col">{label}</th>)}
                </tr>
              </thead>
              <tbody>
                {buildMatchRows(run).map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {row.cells.map((cell) => <td>{cell}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="meta">
            Code checks: {formatChecks(run.code_checks)} · Errors: {run.errors ?? '–'} · Backup model used: {run.fallback_samples ?? '–'}
            {' · '}Cost: {formatRunCost(run)}
          </p>
          {matchNotes[run.run_id] && <p class="note">{matchNotes[run.run_id]}</p>}
        </article>
      ))}
    </section>
  )}

  {compare && (
    <section class="compare">
      <h2>Choosing a model for each step</h2>
      <p>
        Job match runs four steps: read the ad’s requirements, match each requirement to retrieved sections, check each link, and write the guide.
        In round 2 each step was tried with up to three models on its own: the step ran again on what the stored v4 run produced before it, on the same {compare.items_tune ?? '–'} tuning and {compare.items_held_out ?? '–'} held-out ads, one pass, with the other steps left as they were.
        The read step was also tried with up to 12 requirements instead of 8.
      </p>
      <p class="note">
        Only the tuning ads rank the options; held-out ads are reported only. Scores within {compare.tie ?? '–'} of the best count as the same, and then the cheaper option per match wins; an option over {formatMatchCost(compare.cap_per_match_usd)} per match cannot be chosen.
        Cost per match is this step’s measured cost plus the other three steps’ current models; latency per match counts the slowest of the parallel match calls.
        “v4 prompt” is the stored run itself, regraded the same way. Graded by {SUBSCRIPTION_GRADER_LABEL}.
      </p>
      {compare.steps.map((table) => (
        <article class="compare-step">
          <h3>{COMPARE_STEP_LABELS[table.step].step}</h3>
          <div class="table-scroll" tabindex="0" role="region" aria-label={`Model comparison: ${COMPARE_STEP_LABELS[table.step].step}`}>
            <table>
              <caption>{COMPARE_STEP_LABELS[table.step].metric}, best first; the first row is the one chosen.</caption>
              <thead>
                <tr>
                  <th scope="col">Option</th>
                  <th scope="col">Tuning ads</th>
                  <th scope="col">Held-out ads</th>
                  <th scope="col">Cost per match</th>
                  <th scope="col">Latency per match</th>
                </tr>
              </thead>
              <tbody>
                {table.options.map((option, index) => (
                  <tr>
                    <th scope="row">{compareOptionLabel(option, table.step)}{index === 0 && ' (chosen)'}</th>
                    <td>{formatCompareScore(option.score.tune, table.step)}</td>
                    <td>{formatCompareScore(option.score.held_out, table.step)}</td>
                    <td>{formatMatchCost(option.cost_per_match)}{option.over_cap && ' (over the cap)'}</td>
                    <td>{formatSeconds(option.latency_per_match_ms)}</td>
                  </tr>
                ))}
                <tr>
                  <th scope="row">v4 prompt</th>
                  <td>{formatCompareScore(table.old.tune, table.step)}</td>
                  <td>{formatCompareScore(table.old.held_out, table.step)}</td>
                  <td>–</td>
                  <td>–</td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </section>
  )}

  {cot.length > 0 && (
    <section>
      <h2>Does reasoning first help the checker?</h2>
      <p>This compares whether letting a small model write its reasoning before the verdict helps it check whether each sentence is supported.</p>
      {cot.map((run) => (
        <article class="cot-run">
          <h3>{run.date || '–'}</h3>
          <p class="meta">{run.model ?? '–'} · {run.sentences ?? '–'} sentences × {run.repeats ?? '–'} {run.repeats === 1 ? 'pass' : 'passes'}</p>
          <div class="table-scroll" tabindex="0" role="region" aria-label={`Checker comparison for ${run.date}`}>
            <table>
              <caption>Checker comparison: mean and, for repeated passes, lowest–highest pass average.</caption>
              <thead>
                <tr>
                  <th scope="col">Approach</th>
                  <th scope="col">Thinking level</th>
                  <th scope="col">Accuracy</th>
                  <th scope="col">Unsupported precision</th>
                  <th scope="col">Unsupported recall</th>
                  <th scope="col">Invalid</th>
                  <th scope="col">Median ms</th>
                  <th scope="col">Cost</th>
                </tr>
              </thead>
              <tbody>
                {run.arms.map((arm) => (
                  <tr>
                    <th scope="row">{arm.label}</th>
                    <td>{arm.thinking_level ?? '–'}</td>
                    <td>{formatMetric(arm.accuracy, { repeats: run.repeats })}</td>
                    <td>{formatMetric(arm.unsupported_precision, { repeats: run.repeats })}</td>
                    <td>{formatMetric(arm.unsupported_recall, { repeats: run.repeats })}</td>
                    <td>{arm.invalid ?? '–'}</td>
                    <td>{arm.ms_median ?? '–'}</td>
                    <td>{formatCost(arm.cost_usd)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {cotNotes[run.run_id] && <p class="note">{cotNotes[run.run_id]}</p>}
        </article>
      ))}
    </section>
  )}
</Base>

<style>
  .headline-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-0) var(--space-0) var(--space-6);
    padding: var(--space-0);
    font-variant-numeric: tabular-nums;
  }

  .headline-cards li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-inline-size: var(--space-0);
    margin: var(--space-0);
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .headline-value {
    font-size: var(--font-size-proof);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-heading);
  }

  .headline-label {
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
  }

  .headline-cards small {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }

  /* Two 9rem tracks plus the gap exceed the column at 320px; let both shrink. */
  @media (max-width: 24rem) {
    .headline-cards {
      grid-template-columns: repeat(2, minmax(var(--space-0), 1fr));
    }
  }

  .definitions {
    margin: var(--space-0) var(--space-0) var(--space-5);
  }

  .definitions div + div {
    margin-block-start: var(--space-3);
  }

  dt {
    display: inline;
    font-weight: var(--font-weight-semibold);
  }

  dt::after {
    content: ': ';
  }

  dd {
    display: inline;
    margin: var(--space-0);
  }

  .meta,
  .note,
  caption {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }

  .meta,
  .checks,
  .table-scroll {
    font-variant-numeric: tabular-nums;
  }

  .table-scroll {
    max-inline-size: var(--size-full);
    min-inline-size: var(--space-0);
    overflow-x: auto;
    margin-block: var(--space-5);
  }

  /* From 64rem the cards and score tables use the wide column, as #projects does on the home page,
     so every column shows without scrolling; narrower screens scroll inside the frame. */
  @media (min-width: 64rem) {
    .headline-cards,
    .table-scroll {
      inline-size: var(--content-width-wide);
      max-inline-size: none;
      margin-inline: calc((var(--size-full) - var(--content-width-wide)) / 2);
    }
  }

  table {
    display: table;
    inline-size: var(--size-full);
    max-inline-size: none;
    overflow: visible;
    overflow-wrap: normal;
    margin: var(--space-0);
    font-size: var(--font-size-small);
  }

  caption {
    text-align: start;
    padding-block-end: var(--space-3);
  }

  th,
  td {
    vertical-align: top;
  }

  td {
    white-space: nowrap;
  }

  th {
    font-weight: var(--font-weight-semibold);
  }

  .checks h3 {
    margin-block-end: var(--space-3);
  }

  .checks ul {
    font-size: var(--font-size-small);
  }

  .match-run + .match-run,
  .compare-step + .compare-step,
  .cot-run + .cot-run {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-rule);
  }
</style>
