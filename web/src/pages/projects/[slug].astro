---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { addSectionAnchors } from '../../lib/anchors';

export async function getStaticPaths() {
  const projects = await getCollection('pages', ({ id }) => id.startsWith('projects/'));
  return projects.map((entry) => ({
    params: { slug: entry.id.slice('projects/'.length) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
if (!entry.rendered) throw new Error(`Missing rendered content: ${entry.id}`);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <h1>{entry.data.title}</h1>
  <div class="markdown" set:html={addSectionAnchors(entry.rendered.html)} />
</Base>
